classDiagram
    namespace Choose Pathfinding Algorithm {
        class MovementPath {
            +represent_path_waypoints()
            +validate_path_accessibility()
        }
        class PathfindingStrategy {
            +get_movement_path()
            +identify_obstacles()
        }
    }

    namespace Configure Strategy {
        class CombatAction {
            +apply_to_target()
        }
        class CombatTarget {
            +receive_mob_attack()
        }
        class TargetingStrategy {
            +identify_targets_by_criteria()
        }
    }

    namespace Define Mob Template {
        class ActorTemplate {
            +define_minion_type()
        }
        class MobTemplate {
            +define_mob_composition()
            +spawn_mob_instances()
        }
    }

    namespace Form Mob {
        class BoardToken {
            +represent_minion_visually()
        }
        class MinionMember {
            +participate_in_mob()
            +perform_individual_action()
        }
        class Mob {
            +group_minions_together()
            +execute_collective_actions()
        }
    }

    
    %% Associations
    Mob --> MinionMember : uses
    Mob --> CombatAction : uses
    Mob --> TargetingStrategy : uses
    MinionMember --> Mob : uses
    MinionMember --> BoardToken : uses
    MinionMember --> CombatAction : uses
    BoardToken --> MinionMember : uses
    TargetingStrategy --> CombatTarget : uses
    TargetingStrategy --> Mob : uses
    CombatTarget --> BoardToken : uses
    CombatTarget --> CombatAction : uses
    CombatAction --> CombatTarget : uses
    CombatAction --> MinionMember : uses
    MobTemplate --> Mob : uses
    MobTemplate --> ActorTemplate : uses
    ActorTemplate --> MinionMember : uses
    PathfindingStrategy --> Mob : uses
    PathfindingStrategy --> BoardToken : uses
    MovementPath --> PathfindingStrategy : uses
    MovementPath --> Mob : uses
    MovementPath --> BoardToken : uses