#!/bin/bash
# Interactive REPL Launcher for Base Bot (Unix/Linux/Mac)
#
# Usage:
#   ./repl
#
# This launches the interactive REPL session

# Get script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"

# Set environment variables
export PYTHONPATH="$WORKSPACE_ROOT"
export BOT_DIRECTORY="$SCRIPT_DIR"

# Launch REPL
python3 "$SCRIPT_DIR/src/repl_cli/repl_main.py"


