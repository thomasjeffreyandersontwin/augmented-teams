                    "story_file_exists": true,
                    "story_file": "agile_bot/bots/base_bot/docs/stories/map/\ud83c\udfaf Build Agile Bots/\u2699\ufe0f Generate REPL CLI/\ud83d\udcdd Generate Cursor Commands.md"
                  },
