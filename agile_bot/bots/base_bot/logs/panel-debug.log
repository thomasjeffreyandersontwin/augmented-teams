            "story_groups": [
              {
                "type": "and",
                "connector": null,
                "stories": [
                  {
                    "name": "Generate REPL Command Definitions",
                    "sequential_order": 1,
                    "connector": null,
                    "users": [
                      "Generator"
                    ],
                    "story_type": "user",
                    "acceptance_criteria": [
                      "WHEN generator runs, THEN Orchestrator walks all bot behaviors",
