        <mxCell id="ac_e2f3s9_5" value="&lt;div style=&quot;font-size: 8px;&quot;&gt;AND BotLangFlow execution pauses until human provides response via --continue&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;fontSize=8;" parent="1" vertex="1">
