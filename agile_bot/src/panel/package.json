{
  "name": "bot-panel",
  "displayName": "Bot Panel",
  "description": "Visual dashboard for bot status showing workflow, scope, behaviors, and instructions",
  "version": "0.1.34",
  "publisher": "agilebot",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/augmented-teams.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agilebot.viewPanel",
        "title": "View Bot Panel",
        "category": "AgileBot"
      }
    ]
  },
  "scripts": {
    "test": "node --test test/*.js"
  },
  "files": [
    "extension.js",
    "bot_panel.js",
    "panel_view.js",
    "bot/**/*.js",
    "behaviors_view.js",
    "scope_view.js",
    "instructions_view.js",
    "img/**/*.png"
  ]
}
